# Authentication Service Configuration

# Flask
AUTH_SECRET_KEY=change-this-secret-key-in-production

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=asset_management
POSTGRES_USER_FILE=/run/secrets/postgres_user
POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password

# JWT Token Settings
JWT_SECRET_KEY=change-this-jwt-secret-in-production
JWT_ACCESS_TOKEN_HOURS=1
JWT_REFRESH_TOKEN_DAYS=30

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD_FILE=/run/secrets/redis_password

# Active Directory (AD) Settings
AD_ENABLED=false
AD_SERVER=ad.domain.local
AD_PORT=389
AD_USE_SSL=false
AD_BASE_DN=DC=domain,DC=local
AD_USER_DN=CN={username},CN=Users,DC=domain,DC=local
AD_BIND_USER=CN=ServiceAccount,CN=Users,DC=domain,DC=local
AD_BIND_PASSWORD=
AD_USER_SEARCH_FILTER=(sAMAccountName={username})
AD_GROUP_SEARCH_FILTER=(member={user_dn})

# Authentication Settings
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# CORS
CORS_ORIGINS=*
